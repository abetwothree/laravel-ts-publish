{
    // Visit https://aka.ms/tsconfig to read more about this file
    "compilerOptions": {
        // Environment Settings
        // See also https://aka.ms/tsconfig/module
        "module": "preserve",
        "moduleResolution": "bundler",
        "target": "esnext",
        "types": [],

        // Point the app-side aliases the generated tree imports at hand-written stubs, so the token
        // gate can demand zero unresolved modules instead of tolerating a swap inside a count.
        "paths": {
            "@/types/*": ["./tests/types/stubs/app/*"],
            "@js/types/*": ["./tests/types/stubs/js/*"],
            "@workbench/types": ["./tests/types/stubs/workbench/index.d.ts"]
        },

        // Other Outputs
        "sourceMap": true,
        "declaration": true,
        "declarationMap": true,

        // Stricter Typechecking Options
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,

        // Style Options
        "noImplicitReturns": true,
        "noImplicitOverride": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        "noPropertyAccessFromIndexSignature": true,

        // Recommended Options
        "strict": true,
        "jsx": "react-jsx",
        "verbatimModuleSyntax": true,
        "isolatedModules": true,
        "noUncheckedSideEffectImports": true,
        "moduleDetection": "force",
        "skipLibCheck": false,
    },
    "include": [
        "workbench/resources/js/types/data/default-example/**/*.ts",
        "workbench/resources/js/types/data/default-example/**/*.d.ts",
        "tests/types/**/*.ts"
    ]
}
