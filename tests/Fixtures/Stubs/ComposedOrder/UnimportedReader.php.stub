<?php

declare(strict_types=1);

namespace AbeTwoThree\LaravelTsPublish\Tests\Fixtures\Stubs\ComposedOrder;

use AbeTwoThree\LaravelTsPublish\Tests\Fixtures\Ui\Unimported;
use Illuminate\Http\Request;
use Illuminate\Http\Resources\Json\JsonResource;

/**
 * Copied to a temp file under a unique name, so a test can edit a resource whose value is a composed class.
 */
final class UnimportedReader__SUFFIX__ extends JsonResource
{
    /**
     * Publishes one value of the composed class.
     *
     * @return array<string, mixed>
     */
    public function toArray(Request $request): array
    {
        return ['unimported' => $this->unimported()];
    }

    /**
     * The value, by its declared class.
     */
    protected function unimported(): Unimported
    {
        return new Unimported;
    }
}
